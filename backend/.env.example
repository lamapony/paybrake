# Must be sandbox. Anything else, including empty, refuses to start.
PAYPAL_ENV=sandbox
# mock, rest, or toolkit. An empty client id still selects mock.
PAYPAL_ADAPTER=rest
# Sandbox app client id. Empty selects the mock adapter.
PAYPAL_CLIENT_ID=
# Sandbox app secret. Required once the client id is set. Never commit a value.
PAYPAL_CLIENT_SECRET=
# Orders API origin. Empty uses https://api-m.sandbox.paypal.com. https://api.sandbox.paypal.com is also allowed. Any other host is refused.
PAYPAL_BASE_URL=
# Where PayPal sends the browser after approval. Empty uses http://localhost:8080/demo/checkout-return.html.
PAYPAL_RETURN_URL=
# Where PayPal sends the browser on cancel. Empty uses the demo return page with ?cancel=1.
PAYPAL_CANCEL_URL=
# PayPal HTTP timeout in milliseconds. Empty, zero, or not a number uses 10000.
PAYPAL_TIMEOUT_MS=
# off, openrouter, or openai-compatible. Empty picks openrouter when OPENROUTER_API_KEY is set, otherwise openai-compatible when LLM_BASE_URL is set, otherwise off.
LLM_PROVIDER=
# OpenRouter key. A key alone, with LLM_PROVIDER empty, turns classify on as openrouter. Never commit a value.
OPENROUTER_API_KEY=
# OpenAI-compatible base. Requests go to {LLM_BASE_URL}/chat/completions. Empty, and no OpenRouter key, makes classify return 503.
LLM_BASE_URL=
# Bearer token for openai-compatible. Also used as the OpenRouter key when OPENROUTER_API_KEY is empty. Omitted from the request when empty.
LLM_API_KEY=
# Model id. Empty uses openai/gpt-4o-mini on OpenRouter and gpt-4o-mini on openai-compatible.
LLM_MODEL=
# Classify HTTP timeout in milliseconds. Empty, zero, or not a number uses 8000.
LLM_TIMEOUT_MS=
# Listen port. Empty uses 8787.
PORT=8787
# Comma-separated page origins. Empty uses http://localhost:8080 and http://127.0.0.1:8080. chrome-extension:// origins are always allowed.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
