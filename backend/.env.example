# Must be sandbox. Anything else, including empty, refuses to start.
PAYPAL_ENV=sandbox
# mock, rest, or toolkit. An empty client id still selects mock.
PAYPAL_ADAPTER=rest
# Sandbox app client id. Empty selects the mock adapter.
PAYPAL_CLIENT_ID=
# Sandbox app secret. Required once the client id is set. Never commit a value.
PAYPAL_CLIENT_SECRET=
# Orders API origin. Empty uses https://api-m.sandbox.paypal.com. https://api.sandbox.paypal.com is also allowed. Any other host is refused.
PAYPAL_BASE_URL=
# Where PayPal sends the browser after approval. Empty uses http://localhost:8080/demo/checkout-return.html.
PAYPAL_RETURN_URL=
# Where PayPal sends the browser on cancel. Empty uses the demo return page with ?cancel=1.
PAYPAL_CANCEL_URL=
# PayPal HTTP timeout in milliseconds. Empty, zero, or not a number uses 10000.
PAYPAL_TIMEOUT_MS=
# off, typesafe, openrouter, or openai-compatible. Any other value refuses to start.
# Empty picks openai-compatible when LLM_BASE_URL is set, otherwise typesafe when the Typesafe key is set, otherwise openrouter when OPENROUTER_API_KEY is set, otherwise off.
LLM_PROVIDER=
# Typesafe key (https://docs.typesafe.ai). Never commit a value.
TYPESAFE_API_KEY=
# Name of the env var that holds the Typesafe key. Empty uses TYPESAFE_API_KEY.
TYPESAFE_API_KEY_NAME=
# Typesafe API root (before /v1/systemone). Empty uses https://api.typesafe.ai.
TYPESAFE_BASE_URL=
# Typesafe model. Empty uses jev-1.14.0 (pinned; the add threshold was tuned on it).
TYPESAFE_MODEL=
# Confidence at which a Typesafe "risky" answer adds a card when rules are silent. Empty uses 0.5 (picked on dev). Never below 0.5.
TYPESAFE_ADD_CONFIDENCE=
# openrouter: retry a failed Typesafe call on OpenRouter (needs OPENROUTER_API_KEY). Empty means no fallback.
LLM_FALLBACK=
# OpenRouter model for the fallback. Empty uses openai/gpt-4o-mini.
OPENROUTER_MODEL=
# OpenRouter key. With LLM_PROVIDER empty, LLM_BASE_URL empty, and no Typesafe key, this selects openrouter. Never commit a value.
OPENROUTER_API_KEY=
# OpenAI-compatible base. Requests go to {LLM_BASE_URL}/chat/completions.
# For openrouter, used only when it is https on openrouter.ai. Any other host is ignored.
# Empty, with no Typesafe key and no OpenRouter key, makes classify return 503.
LLM_BASE_URL=
# Bearer token for openai-compatible. Also used as the OpenRouter key when OPENROUTER_API_KEY is empty. Omitted from the request when empty.
LLM_API_KEY=
# Model id. Empty uses openai/gpt-4o-mini on OpenRouter and gpt-4o-mini on openai-compatible.
LLM_MODEL=
# Classify HTTP timeout in milliseconds. Empty, zero, or not a number uses 8000.
LLM_TIMEOUT_MS=
# Listen port. Empty uses 8787.
PORT=8787
# Comma-separated page origins. Empty uses http://localhost:8080 and http://127.0.0.1:8080. chrome-extension:// origins are always allowed.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
