{
  "manifest_version": 3,
  "name": "PayBrake",
  "version": "0.2.0.4",
  "version_name": "0.2.0-test.4",
  "description": "Brakes before you pay. Flags risky payment asks in a chat and can open a sandbox order.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://paybrake-demo.spbabinov.workers.dev/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PayBrake: open the welcome page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://paybrake-demo.spbabinov.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "lib/brand.js",
        "lib/tidy.js",
        "lib/atoms.js",
        "lib/extract.js",
        "lib/redact.js",
        "lib/pay-risk.js",
        "lib/ask-llm.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "card.css"
      ],
      "matches": [
        "https://paybrake-demo.spbabinov.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ]
    }
  ]
}
