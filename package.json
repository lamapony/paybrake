{
  "name": "paybrake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "extension",
    "backend"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "eval": "node eval/run-eval.mjs --mode=rules",
    "dev:backend": "node backend/src/server.js",
    "serve:demo": "node scripts/serve.mjs",
    "shots": "node scripts/shot-demo.cjs",
    "e2e": "node tests/e2e/ext-smoke.cjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "hosted:build": "node scripts/build-hosted.mjs",
    "hosted:deploy": "node scripts/build-hosted.mjs && cd hosted && npx wrangler deploy",
    "hosted:dev": "node scripts/build-hosted.mjs && cd hosted && npx wrangler dev",
    "e2e:hosted": "node tests/e2e/hosted-e2e.cjs",
    "eval:real:download": "node eval/real/download.mjs",
    "eval:real": "node eval/real/run-real.mjs"
  },
  "optionalDependencies": {
    "playwright-core": "1.63.0"
  }
}
