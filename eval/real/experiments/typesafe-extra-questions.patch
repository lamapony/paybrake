+    const q = JSON.parse(init.body).questions;
+    assert.deepEqual(["premium", "prize", "lure"].filter((k) => q[k] && q[k].type === "noul"), ["premium", "prize", "lure"]);
+    return answer({ risky: { type: "noul", noul: 0.2 }, signal: { type: "choice", choice: "other" }, ...extra });
